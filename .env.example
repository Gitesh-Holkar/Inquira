# Copy to .env.local and fill in. NEVER commit .env.local.

# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# Transaction pooler URI (Connect → Transaction pooler), port 6543
DATABASE_URL=postgresql://postgres.YOUR-REF:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Only needed for `npm run db:remote:apply` (Management API over HTTPS)
SUPABASE_ACCESS_TOKEN=sbp_xxx
SUPABASE_PROJECT_REF=YOUR-REF

# --- App ---
# Public URL of the app (used for OAuth redirect URIs). No trailing slash.
APP_URL=http://localhost:3000
# 32 random bytes, base64. Generate with: npm run gen:keys
APP_ENCRYPTION_KEY=
# Shared secret for /api/cron/* (sent as header x-cron-secret). Generate with: npm run gen:keys
CRON_SECRET=

# --- Seed (npm run db:seed) ---
SEED_OWNER_EMAIL=owner@example.com
SEED_ORG_NAME="STDM Food & Beverages Pvt. Ltd."

# --- Local development only ---
# AUTH_MODE=dev lets you sign in as a seeded user without Supabase Auth.
# It is refused when NODE_ENV=production or on Vercel.
# AUTH_MODE=dev
