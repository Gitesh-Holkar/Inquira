    "drizzle-orm": "0.45.3",
    "libphonenumber-js": "1.13.14",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "next-themes": "0.4.6",
    "node-html-parser": "9.0.4",
    "postgres": "3.4.9",
